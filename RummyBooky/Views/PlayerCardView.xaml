<?xml version="1.0" encoding="utf-8" ?>

<views:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pages="clr-namespace:RummyBooky.Pages" xmlns:viewmodels="clr-namespace:RummyBooky.ViewModels" xmlns:models="clr-namespace:RummyBooky.Models" xmlns:views="clr-namespace:RummyBooky.Views" x:Class="RummyBooky.Views.PlayerCardView" x:DataType="models:PlayerModel" x:Name="This">
    <Border x:Name="CardBorder" Background="{AppThemeBinding Light={StaticResource Slate50}, Dark={StaticResource Slate800}}" Stroke="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" StrokeShape="RoundRectangle 16" Padding="16">
        <Grid x:Name="CardContentRoot" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
            <Grid x:Name="HeaderGrid" Grid.Row="0" RowDefinitions="Auto" ColumnDefinitions="Auto,*" Margin="8,0,16,16">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="4" HorizontalOptions="Start" VerticalOptions="Start">
                    <Label Grid.Row="0" Text="{Binding CardRankSymbol}" Style="{StaticResource SubtitleLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Image Grid.Row="1" Source="{Binding ImageSource}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <Grid x:Name="HeaderContentLayout" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalOptions="Fill">
                    <Grid x:Name="PlayerNameChip" Grid.Column="0" Padding="12,8" Margin="8,0,0,0" BackgroundColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" VerticalOptions="Fill">
                        <Label x:Name="PlayerNameLabel" Style="{StaticResource PlayerLabel}" Text="{Binding PlayerName}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Slate50}, Dark={StaticResource Slate800}}" />
                    </Grid>
                    <ImageButton x:Name="EditPlayerButton" Grid.Column="1" Source="{AppThemeBinding Light=edit_player_light.png, Dark=edit_player_dark.png}" Clicked="OnEditPlayerButtonClicked" Command="{Binding Source={x:Reference This}, Path=Command}" CommandParameter="{Binding .}">
                    </ImageButton>
                </Grid>
            </Grid>

            <Grid x:Name="PlayerStatsGrid" Grid.Row="1" ColumnDefinitions="*,16,Auto" RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1" RowSpacing="8" HorizontalOptions="Fill">

                <Label Grid.Column="0" Grid.Row="0" Text="Total Games Played" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="0" Text="{Binding TotalGamesPlayed}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="2" Text="Games Won" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="2" Text="{Binding GamesWon}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="4" Text="Games Lost" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="4" Text="{Binding GamesLost}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="6" Text="Games Forfeit" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="6" Text="{Binding GamesForfeit}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="7" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="8" Text="Game Draws" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="8" Text="{Binding GameDraws}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="9" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="10" Text="Highest Scored Hand" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="10" Text="{Binding HighestScoredHand}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="11" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="12" Text="Lowest Scored Hand" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="12" Text="{Binding LowestScoredHand}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="13" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />

                <Label Grid.Column="0" Grid.Row="14" Text="Lifetime Score" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Start" />
                <Label Grid.Column="2" Grid.Row="14" Text="{Binding LifetimeScore}" Style="{StaticResource BodyLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" FontAttributes="Bold" HorizontalOptions="End" />
                <BoxView Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="15" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />
            </Grid>

            <Grid x:Name="FooterGrid" Grid.Row="2" RowDefinitions="Auto" ColumnDefinitions="*,Auto" Margin="16,8,16,8" ColumnSpacing="8" HorizontalOptions="Fill" VerticalOptions="End">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Player Created" Style="{StaticResource CaptionLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding PlayerCreatedDate}" Style="{StaticResource CaptionLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" HorizontalOptions="Center" />
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4" HorizontalOptions="End" VerticalOptions="Center" Rotation="180">
                    <Label Grid.Row="0" Text="{Binding CardRankSymbol}" Style="{StaticResource SubtitleLabelStyle}" TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Image Grid.Row="1" Source="{Binding ImageSource}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</views:BaseView>
