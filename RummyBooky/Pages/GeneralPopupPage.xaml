<?xml version="1.0" encoding="utf-8" ?>

<pages:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pages="clr-namespace:RummyBooky.Pages" xmlns:viewmodels="clr-namespace:RummyBooky.ViewModels" xmlns:models="clr-namespace:RummyBooky.Models" xmlns:views="clr-namespace:RummyBooky.Views" x:Class="RummyBooky.Pages.GeneralPopupPage" x:DataType="viewmodels:GeneralPopupViewModel" x:TypeArguments="viewmodels:GeneralPopupViewModel" Background="Transparent">

    <Border Padding="24" Margin="16" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="460" MaximumWidthRequest="500"
            Stroke="{AppThemeBinding Light={StaticResource Pink}, Dark={StaticResource Pink}}"
            StrokeThickness="2"
            Background="{AppThemeBinding Light={StaticResource Slate100}, Dark={StaticResource Slate900}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#33000000, Dark=#80000000}" Offset="0,8" Radius="20" Opacity="0.6"/>
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

            <!-- Decorative Header Icon Badge -->
            <Border Grid.Row="0" WidthRequest="52" HeightRequest="52"
                    StrokeShape="RoundRectangle 26"
                    Stroke="{AppThemeBinding Light={StaticResource Pink}, Dark={StaticResource Pink}}"
                    StrokeThickness="2"
                    Background="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate800}}"
                    HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,4">
                <Image Source="{AppThemeBinding Light=dealer_icon_light.png, Dark=dealer_icon_dark.png}"
                       WidthRequest="28" HeightRequest="28"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Popup Title -->
            <Label Grid.Row="1" Text="{Binding Title}"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <!-- Subtitle / Message -->
            <Label Grid.Row="2" Text="{Binding Message}"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate300}}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,8" />

            <!-- Player Selection Cards -->
            <CollectionView Grid.Row="3" IsVisible="{Binding DisplayWinners}" ItemsSource="{Binding WinningPlayers}" SelectionMode="Single" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}" Margin="0,0,0,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlayerModel">
                        <Border x:Name="PlayerTileBorder"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Slate300}, Dark={StaticResource Slate700}}"
                                StrokeThickness="1.5"
                                Background="{AppThemeBinding Light={StaticResource Slate50}, Dark={StaticResource Slate800}}"
                                Padding="14,10" Margin="0,4"
                                MinimumHeightRequest="52">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GeneralPopupViewModel}}, Path=SelectPlayerCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Slate50}, Dark={StaticResource Slate800}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Slate300}, Dark={StaticResource Slate700}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Pink}, Dark={StaticResource Pink}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Pink}, Dark={StaticResource DeepRed}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Border Grid.Column="0" WidthRequest="32" HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}"
                                        StrokeThickness="0">
                                    <Image Source="{AppThemeBinding Light=dealer_icon_light.png, Dark=dealer_icon_dark.png}"
                                           WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1" Text="{Binding PlayerName}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Slate900}, Dark={StaticResource White}}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="2" Text="{Binding LifetimeScore, StringFormat='Pts: {0}'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Slate500}, Dark={StaticResource Slate400}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Action Buttons -->
            <FlexLayout Grid.Row="4" Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" AlignContent="Center">
                <Button x:Name="OkayButton" IsVisible="{Binding DisplayOkayButton}" Text="Okay" Margin="6" MinimumWidthRequest="110" Command="{Binding OkayClickedCommand}" Clicked="OnButtonClicked">
                </Button>

                <Button x:Name="QuitButton" IsVisible="{Binding DisplayQuitButton}" Text="Quit" Margin="6" MinimumWidthRequest="110" Command="{Binding QuitClickedCommand}" Clicked="OnButtonClicked">
                </Button>

                <Button x:Name="WinnerButton" IsVisible="{Binding DisplayWinnerButton}" Text="{Binding ConfirmButtonText}" Margin="6" MinimumWidthRequest="110" Command="{Binding ConfirmWinnerCommand}" Clicked="OnButtonClicked">
                </Button>

                <Button x:Name="DrawButton" IsVisible="{Binding DisplayDrawButton}" Text="Draw" Margin="6" MinimumWidthRequest="110" Command="{Binding DrawGameCommand}" Clicked="OnButtonClicked">
                </Button>

                <Button x:Name="CancelButton" Text="Cancel" Margin="6" MinimumWidthRequest="110" Command="{Binding CancelClickedCommand}" Clicked="OnButtonClicked">
                </Button>
            </FlexLayout>
        </Grid>
    </Border>
</pages:BasePopupPage>
