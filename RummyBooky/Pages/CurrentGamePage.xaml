<?xml version="1.0" encoding="utf-8" ?>

<pages:BasePage x:Name="thisPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pages="clr-namespace:RummyBooky.Pages" xmlns:viewmodels="clr-namespace:RummyBooky.ViewModels" xmlns:models="clr-namespace:RummyBooky.Models" xmlns:views="clr-namespace:RummyBooky.Views" x:Class="RummyBooky.Pages.CurrentGamePage" x:DataType="viewmodels:CurrentGameViewModel" x:TypeArguments="viewmodels:CurrentGameViewModel" Background="{AppThemeBinding Light={StaticResource Slate50}, Dark={StaticResource Slate950}}">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill" Padding="16" RowSpacing="16" MaximumWidthRequest="700" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Header Info -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Button x:Name="PreviousRoundButton" Text="◀" WidthRequest="36" HeightRequest="36" Padding="0"
                        Command="{Binding PreviousRoundCommand}" Clicked="OnPreviousRoundClicked"
                        IsVisible="{Binding CanGoToPreviousRound}" />
                <Label Text="{Binding RoundText}" VerticalOptions="Center" Style="{StaticResource TagHeader}" />
                <Button x:Name="NextRoundButton" Text="▶" WidthRequest="36" HeightRequest="36" Padding="0"
                        Command="{Binding NextRoundCommand}" Clicked="OnNextRoundClicked"
                        IsVisible="{Binding CanGoToNextRound}" />
            </HorizontalStackLayout>
            <Label Grid.Column="2" Text="{Binding ScoreLimit, StringFormat='Score Limit: {0}'}" VerticalOptions="Center" HorizontalOptions="End" Style="{StaticResource TagHeader}" />
        </Grid>

        <!-- Navigation Actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Button x:Name="MainPageButton" Grid.Column="0" Text="Main Page" HorizontalOptions="Fill" Command="{Binding GoToMainPageCommand}" Clicked="OnMainPageClicked">
            </Button>

            <Button x:Name="EditGameButton" Grid.Column="1" Text="Edit Game" HorizontalOptions="Fill" Command="{Binding EditGameCommand}" Clicked="OnEditGameClicked">
            </Button>

            <Button x:Name="QuitGameButton" Grid.Column="2" Text="Quit Game" HorizontalOptions="Fill" Command="{Binding QuitGameCommand}" Clicked="OnQuitGameClicked">
            </Button>
        </Grid>

        <!-- Players Table -->
        <VerticalStackLayout Grid.Row="2" HorizontalOptions="Fill" VerticalOptions="Start" Spacing="0">
            <!-- Header -->
            <Grid x:Name="HeaderRoot" ColumnSpacing="0" ColumnDefinitions="*,2,95,2,115" RowDefinitions="65,1" HeightRequest="66">
                <BoxView Grid.Row="0" Grid.ColumnSpan="5" Color="{AppThemeBinding Light={StaticResource Slate100}, Dark={StaticResource Slate900}}" HorizontalOptions="Fill" VerticalOptions="Fill" />
                <Label Grid.Row="0" Grid.Column="0" Text="Player" Style="{StaticResource TagLabelNoBackground}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                <BoxView Grid.Row="0" Grid.Column="1" WidthRequest="1" HorizontalOptions="Center" VerticalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />
                <Label Grid.Row="0" Grid.Column="2" Text="Total Score" Style="{StaticResource TagLabelNoBackground}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                <BoxView Grid.Row="0" Grid.Column="3" WidthRequest="1" HorizontalOptions="Center" VerticalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Slate200}, Dark={StaticResource Slate700}}" />
                <Label Grid.Row="0" Grid.Column="4" Text="Round Score" Style="{StaticResource TagLabelNoBackground}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                <BoxView Grid.Row="1" Grid.ColumnSpan="5" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" VerticalOptions="End" HorizontalOptions="Fill" />
            </Grid>
            <!-- Player Rows -->
            <VerticalStackLayout x:Name="PlayersListStack" Spacing="0" />
        </VerticalStackLayout>

        <!-- Calculate / Return to Active Round Action Button -->
        <Grid Grid.Row="3">
            <Button x:Name="CalculateScoresButton" Text="Calculate Scores" Command="{Binding CalculatePlayerScoresCommand}" Clicked="OnCalculateScoresClicked" IsVisible="{Binding IsNotViewingPreviousRound}">
            </Button>
            <Button x:Name="ReturnToActiveRoundButton" Text="Return to Current Round" Command="{Binding ReturnToActiveRoundCommand}" Clicked="OnReturnToActiveRoundClicked" IsVisible="{Binding IsViewingPreviousRound}">
            </Button>
        </Grid>

        <!-- Game Statistics & Round Summary -->
        <Border Grid.Row="4" Style="{StaticResource ThemeBorder}" Padding="16" HorizontalOptions="Fill">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <Label Grid.Row="0" Style="{StaticResource PlayerLabel}" Text="{Binding GameStart, StringFormat='Game Started: {0:MM/dd/yy h:mm:ss tt}'}" HorizontalOptions="Center" />

                <Label Grid.Row="1" IsVisible="{Binding DisplayPlayersHighestLowestHands}" Style="{StaticResource PlayerLabel}" Text="{Binding CurrentRound.CurrentHighestScoredHandValue, StringFormat='Highest Hand Played: {0}'}" HorizontalOptions="Center" />

                <Label Grid.Row="2" IsVisible="{Binding DisplayPlayersHighestLowestHands}" Style="{StaticResource PlayerLabel}" Text="{Binding CurrentRound.PlayerHighestScoringHand.PlayerName, StringFormat='Played by: {0}'}" HorizontalOptions="Center" />

                <Label Grid.Row="3" IsVisible="{Binding DisplayPlayersHighestLowestHands}" Style="{StaticResource PlayerLabel}" Text="{Binding CurrentRound.CurrentLowestScoredHandValue, StringFormat='Lowest Hand Played: {0}'}" HorizontalOptions="Center" />

                <Label Grid.Row="4" IsVisible="{Binding DisplayPlayersHighestLowestHands}" Style="{StaticResource PlayerLabel}" Text="{Binding CurrentRound.PlayerLowestScoringHand.PlayerName, StringFormat='Played by: {0}'}" HorizontalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</pages:BasePage>