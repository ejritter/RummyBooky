<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:RummyBooky.Pages"
             xmlns:viewmodels="clr-namespace:RummyBooky.ViewModels"
             xmlns:models="clr-namespace:RummyBooky.Models"
             xmlns:views="clr-namespace:RummyBooky.Views"
             x:Class="RummyBooky.Pages.LeaderboardPage"
             x:DataType="viewmodels:LeaderboardViewModel"
             x:TypeArguments="viewmodels:LeaderboardViewModel">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">
        <Label Grid.Row="0"
               Style="{StaticResource TagHeader}"
               Text="{Binding HeaderText}"
               HorizontalOptions="Center"/>

        <CollectionView Grid.Row="1"
                        Margin="0,30,0,0"
                        ItemsSource="{Binding TopPlayers}"
                        IsVisible="{Binding DisplayLeaderboard}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LeaderboardPlayerModel">
                    <views:PlayerCardView AssignedPlayerModel="{Binding Player}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:BasePage>