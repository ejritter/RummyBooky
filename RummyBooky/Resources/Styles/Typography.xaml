<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Explicit Label Typography Styles -->
    <Style TargetType="Label" x:Key="HeaderLabelStyle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Slate900}, Dark={StaticResource Slate50}}" />
    </Style>

    <Style TargetType="Label" x:Key="SubtitleLabelStyle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" />
    </Style>

    <Style TargetType="Label" x:Key="BodyLabelStyle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Slate900}, Dark={StaticResource Slate50}}" />
    </Style>

    <Style TargetType="Label" x:Key="CaptionLabelStyle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" />
    </Style>

</ResourceDictionary>
