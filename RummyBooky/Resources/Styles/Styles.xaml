    <Style TargetType="Image" x:Key="RummyBookyImage">
        <Setter Property="Source" Value="{AppThemeBinding Light=rummy_booky.png, Dark=rummy_booky.png}"/>
        <Setter Property="HeightRequest" Value="500"/>
        <Setter Property="WidthRequest"  Value="500"/>
    </Style>


