        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Slate900}, Dark={StaticResource Slate50}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Slate900}, Dark={StaticResource Slate50}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Slate100}, Dark={StaticResource Slate900}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource DeepRed}, Dark={StaticResource Pink}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Slate600}, Dark={StaticResource Slate400}}" />
